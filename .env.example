APP_NAME=OGameX
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOG_LEVEL=debug
APP_URL=http://localhost

# Optional: change Docker exposed ports (host:container mapping)
# HTTP_PORT=80
# HTTPS_PORT=443
# PHPMYADMIN_PORT=8080
# DB_EXTERNAL_PORT=3306

# Enable debugbar for local development
DEBUGBAR_ENABLED=false
# Absolute path to the current directory in Docker container
DEBUGBAR_REMOTE_SITES_PATH=/var/www
# Absolute path to the current directory
DEBUGBAR_LOCAL_SITES_PATH=/path/to/your/project

DISCORD_ALERT_WEBHOOK=

DB_CONNECTION=mysql
DB_HOST=ogamex-db
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=toor

BROADCAST_CONNECTION=reverb
CACHE_DRIVER=file
SESSION_DRIVER=database
SESSION_LIFETIME=720

# Queue driver. Keep "database" for the default stack: the fleet-arrival service
# tracks delayed jobs by their jobs-table ID and the test suite inspects that table.
# Laravel Horizon requires "redis" (see the Horizon section below).
QUEUE_CONNECTION=database

# Must exceed the ProcessFleetArrival job timeout (600s) or a long battle job is
# re-dispatched to a second worker while it is still running.
DB_QUEUE_RETRY_AFTER=660
# Same requirement for the redis connection used by Horizon.
REDIS_QUEUE_RETRY_AFTER=660

# For a non-Docker install. The Docker Compose stacks point their containers at
# their own Redis, overriding this value.
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Redis client used by Laravel. "phpredis" (the default) needs the phpredis PHP
# extension, which the Docker image installs. Use "predis" only if you run PHP
# outside Docker and cannot install the extension (requires predis/predis).
# REDIS_CLIENT=phpredis

# Laravel Horizon (optional queue manager)
#
# Horizon adds a monitoring dashboard for the queues defined in
# app/Enums/QueueName.php (see config/horizon.php). It only supports Redis, which the
# Docker Compose stacks already run. To enable it, change QUEUE_CONNECTION above to
# redis and bring the stack back up:
#   docker compose --profile queue up -d
# The queue container detects the driver and starts Horizon instead of the database
# worker pools, and a "Queue monitoring" link appears in the admin bar.
#
# The dashboard lives at /admin/horizon and is restricted to users with the
# "admin" role.
#
# Worker tuning. production, staging, local and any other APP_ENV are all supported;
# environments without their own block fall back to the local-sized pools. Every value
# has a per-environment default and only needs setting to override it for the active
# environment. Pool ceilings must be >= 1 (the heavy lane >= 2, since it watches two
# queues), and the fleet timeout must stay above 600s (ProcessFleetArrival's own
# timeout) and below REDIS_QUEUE_RETRY_AFTER, or a battle can be killed or double-run.
# HORIZON_DEFAULT_MAX_PROCESSES=
# HORIZON_FLEET_LIGHT_MAX_PROCESSES=
# HORIZON_FLEET_HEAVY_MAX_PROCESSES=
# HORIZON_MEMORY_LIMIT=
# HORIZON_DEFAULT_MEMORY=
# HORIZON_DEFAULT_TIMEOUT=
# HORIZON_FLEET_MEMORY=
# HORIZON_FLEET_TIMEOUT=
# HORIZON_FLEET_SLEEP=
#
# Note: on Redis the fleet-arrival service cannot track delayed jobs by their
# integer jobs-table ID, so mission updates may dispatch duplicate (still
# idempotent) arrival jobs. See AppServiceProvider for details.
# HORIZON_NAME=
# HORIZON_PREFIX=
# HORIZON_PATH=admin/horizon
# HORIZON_FAST_TERMINATION=false

# Set to 0 to disable throttle during local development (default: 60 seconds)
AUTH_PASSWORD_RESET_THROTTLE=60

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@ogamex.dev"
MAIL_FROM_NAME="${APP_NAME}"

# To use Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_ENCRYPTION=tls
# Other providers: Mailgun, Postmark, Resend — configure MAIL_HOST/PORT/CREDENTIALS above.

REVERB_APP_ID=ogamex
REVERB_APP_KEY=ogamex-key
REVERB_APP_SECRET=ogamex-secret
REVERB_HOST=localhost
REVERB_PORT=8090
# Use https when the local site is served through Lerd, Herd, Valet, or another
# HTTPS development proxy. Plain HTTP sites should use http.
REVERB_SCHEME=http

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8090

# Local Docker development with host services
# Used by local-docker-dev/docker-compose.yml when Lerd, Herd, Valet, or another
# local environment already provides MySQL, Redis, and the web server.
# These settings do not change the default Docker Compose database above.
LOCAL_DB_HOST=host.docker.internal
LOCAL_DB_PORT=3306
LOCAL_DB_DATABASE=ogamex-test
LOCAL_DB_USERNAME=root
LOCAL_DB_PASSWORD=
LOCAL_REDIS_HOST=host.docker.internal
LOCAL_REDIS_PORT=6379
LOCAL_REDIS_PASSWORD=null
QUEUE_WORKERS_LIGHT=2
QUEUE_WORKERS_HEAVY=3
PHP_FPM_PORT=9000

# Native prepared statements add a round trip per query. When the database is
# reached over a slow link (for example the Docker host gateway), enable
# client-side statement emulation: DB_EMULATE_PREPARES=true
# Leave unset in production. The test suites already enable it in phpunit.xml.
REVERB_SERVER_PORT=8090
